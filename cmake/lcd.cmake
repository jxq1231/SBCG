# User-owned display integration; all peripheral setup stays generated by CubeMX.
file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/SBCG.ioc" _sbcg_ltdc REGEX "^LTDC\\.ActiveW=")
option(SBCG_SDRAM_DIAGNOSTIC "Run exclusive destructive U1 SDRAM test instead of the U2 display" OFF)
if(_sbcg_ltdc AND NOT SBCG_SDRAM_DIAGNOSTIC)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${CMAKE_CURRENT_SOURCE_DIR}/SBCG.ioc"
        "${CMAKE_CURRENT_SOURCE_DIR}/Core/Src/main.c"
        "${CMAKE_CURRENT_SOURCE_DIR}/Core/Src/stm32f7xx_hal_msp.c"
        "${CMAKE_CURRENT_SOURCE_DIR}/Core/Inc/main.h"
        "${CMAKE_CURRENT_SOURCE_DIR}/Core/Src/stm32f7xx_it.c"
        "${CMAKE_CURRENT_SOURCE_DIR}/Tools/Monitor/check_ltdc_config.py")
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    execute_process(COMMAND "${Python3_EXECUTABLE}" -B
        "${CMAKE_CURRENT_SOURCE_DIR}/Tools/Monitor/check_ltdc_config.py"
        RESULT_VARIABLE _ltdc_result OUTPUT_VARIABLE _ltdc_output ERROR_VARIABLE _ltdc_error)
    if(NOT _ltdc_result EQUAL 0)
        message(FATAL_ERROR "Generated LTDC configuration failed preflight; regenerate in CubeMX.\n${_ltdc_output}${_ltdc_error}")
    endif()
    target_compile_definitions(${CMAKE_PROJECT_NAME} PRIVATE SBCG_USE_LCD=1)
    target_sources(${CMAKE_PROJECT_NAME} PRIVATE
        App/BSP/bsp_lcd.c App/UI/status_service.c App/UI/status_view.c
        App/UI/status_screen.c App/UI/rgb565_canvas.c)
endif()
